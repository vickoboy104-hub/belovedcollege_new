# Shared-hosting front controller for installations where the entire Laravel
# project must live inside the web root. Prefer pointing the host document root
# directly at /public whenever the hosting panel supports it.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow ACME/SSL verification files when the host uses .well-known.
    RewriteCond %{REQUEST_URI} !^/\.well-known(?:/|$) [NC]
    RewriteRule (^|/)\. - [F,L]

    # Never expose Laravel application/source directories directly.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(?:/|$) - [F,L,NC]

    # Never expose project metadata, secrets, build configuration, or CLI entrypoints.
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js|DEPLOYMENT\.md|README\.md|\.env(?:\..*)?)$ - [F,L,NC]

    # Route the public URL space through Laravel's actual public directory.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
